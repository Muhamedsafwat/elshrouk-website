{
  "name": "alshorouk-web",
  "version": "1.0.0",
  "private": true,
  "description": "Alshorouk (الشروق) — Arabic-first corporate website and CMS for a poultry-sector supplier/distributor.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --port 3100",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start --port 3100",
    "typecheck": "tsc --noEmit",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "format": "prettier --write .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/seed.ts",
    "seed:fixtures": "cross-env NODE_OPTIONS=--no-deprecation SEED_FIXTURES=true payload run src/scripts/seed.ts",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "cross-env NODE_OPTIONS=--no-deprecation vitest run",
    "test:e2e": "cross-env NODE_OPTIONS=--no-deprecation playwright test --project=desktop --project=mobile",
    "test:e2e:engines": "cross-env NODE_OPTIONS=--no-deprecation playwright test --project=webkit --project=mobile-safari --project=firefox",
    "screenshots": "cross-env NODE_OPTIONS=--no-deprecation playwright test --project=screenshots",
    "build:e2e": "cross-env NEXT_DIST_DIR=.next-e2e DATABASE_URL=file:./data/e2e.db DEMO_FIXTURES=true SITE_URL=http://localhost:3200 NEXT_PUBLIC_SITE_URL=http://localhost:3200 NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "start:e2e": "cross-env INQUIRY_IP_HEADER=x-real-ip NEXT_DIST_DIR=.next-e2e DATABASE_URL=file:./data/e2e.db DEMO_FIXTURES=true SITE_URL=http://localhost:3200 NODE_OPTIONS=--no-deprecation next start --port 3200",
    "seed:e2e": "cross-env DATABASE_URL=file:./data/e2e.db SEED_FIXTURES=true NODE_OPTIONS=--no-deprecation payload run src/scripts/seed.ts"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/db-sqlite": "3.90.2",
    "@payloadcms/email-nodemailer": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-s3": "3.90.2",
    "@payloadcms/translations": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "clsx": "2.1.1",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "gsap": "3.15.0",
    "next": "16.3.8",
    "payload": "3.90.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.8",
    "jsdom": "28.0.0",
    "prettier": "^3.4.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=20.18.1",
    "pnpm": "^9 || ^10 || ^11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver",
      "@tailwindcss/oxide"
    ],
    "overrides": {
      "undici": "^7.29.1",
      "dompurify": "^3.4.16"
    }
  }
}
