# ─────────────────────────────────────────────────────────────────────────────
# Alshorouk website — environment variables
# Copy to `.env` for local development. NEVER commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# Database. The adapter is chosen by the scheme:
#   file:./data/alshorouk.db          → SQLite (local development / staging preview)
#   postgres://user:pass@host:5432/db → PostgreSQL (production; run migrations, see docs/deployment.md)
DATABASE_URL=file:./data/alshorouk.db

# Long random string (≥ 32 chars) used by Payload to sign auth tokens. REQUIRED in production.
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Public origin of the site (no trailing slash). Used for canonical URLs, sitemap, CSRF/CORS.
# SITE_URL is read at RUNTIME on the server; NEXT_PUBLIC_SITE_URL is inlined at BUILD time. Set both to the same value.
SITE_URL=http://localhost:3100
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# development | staging | production — only "production" (+ CMS site status "production") allows indexing.
NEXT_PUBLIC_SITE_ENV=development

# ── Optional: first admin account for LOCAL seeding only (pnpm seed) ──────────
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=

# ── Optional: show isolated test fixtures with a visible "demo data" banner ───
# Only with a dedicated fixture database (e.g. DATABASE_URL=file:./data/e2e.db).
# DEMO_FIXTURES=true

# ── Inquiry rate limiting: the client-IP header your hosting proxy sets and visitors cannot forge ──
# e.g. x-real-ip (nginx), x-vercel-forwarded-for (Vercel), cf-connecting-ip (only behind Cloudflare).
# REQUIRED in production: without it the per-client limit can be bypassed by rotating headers, so a
# global cap (30 submissions / 10 min for all visitors) applies as a fail-safe.
# INQUIRY_IP_HEADER=x-real-ip

# ── Optional: origin the proxy uses to ask its own public API whether a product/article slug exists ──
# Missing slugs then get a server-rendered 404. Defaults to SITE_URL (never to the request's Host header); on a
# VPS set a loopback origin (e.g. http://127.0.0.1:3000) so the check does not leave the machine. If the check
# fails, the page decides as before (still a 404, rendered in the browser).
# INTERNAL_SITE_ORIGIN=http://127.0.0.1:3000

# ── Optional: inquiry e-mail notifications (no PII is sent; staff open the CMS) ──
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM_ADDRESS=
# SMTP_FROM_NAME=Alshorouk CMS
# INQUIRY_NOTIFY_EMAIL=

# ── Optional: S3-compatible media storage (production) ─────────────────────────
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=            # e.g. Cloudflare R2 / MinIO endpoint; leave empty for AWS
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ── Optional: analytics (no-op until a provider + consent strategy are approved) ─
# NEXT_PUBLIC_ANALYTICS_PROVIDER=
