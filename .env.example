# Database. The adapter is chosen by the scheme:
#   file:./data/alshorouk.db          → SQLite (local development / staging preview)
#   postgres://user:pass@host:5432/db → PostgreSQL (production; run migrations, see docs/deployment.md)
DATABASE_URL=postgresql://neondb_owner:npg_TNq1PC4zGaps@ep-gentle-credit-b5pmw1v4.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Long random string (≥ 32 chars) used by Payload to sign auth tokens. REQUIRED in production.
PAYLOAD_SECRET=fdkgjslkdjasjrkjfkldsnfldsnf

# Public origin of the site (no trailing slash). Used for canonical URLs, sitemap, CSRF/CORS.
# SITE_URL is read at RUNTIME on the server; NEXT_PUBLIC_SITE_URL is inlined at BUILD time. Set both to the same value.
SITE_URL=http://localhost:3001

NEXT_PUBLIC_SITE_URL=http://localhost:3001

# development | staging | production — only "production" (+ CMS site status "production") allows indexing.
NEXT_PUBLIC_SITE_ENV=development